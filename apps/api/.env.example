# Copy to .env and fill in. `.env` is never committed.

PORT=4100
# Where the web app runs. Links in emails land here.
APP_URL=http://127.0.0.1:5180
DATABASE_URL=postgres://erp:erp@127.0.0.1:5433/erp

# Encrypts sensitive values at rest (government ID numbers, from Phase 1). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Email. Leave both empty and emails (confirmation and reset links) are printed in this terminal.
#
# Brevo (300 emails a day free): verify the sender address under "Senders, domains & dedicated IPs",
# then create an API key under "SMTP & API" → "API keys". MAIL_FROM must be that verified address.
BREVO_API_KEY=
MAIL_FROM="ERP <no-reply@erp.local>"
# Any other mail server, used only when BREVO_API_KEY is empty.
SMTP_URL=

# Production only (the host's dashboard, not this file):
#   API_URL          this server's public address
#   EXTRA_ORIGINS    other addresses allowed to call the API, comma separated
